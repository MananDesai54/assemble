{
  "name": "assemble",
  "version": "0.2.0",
  "description": "Your desk is the input device — local-first gestures, voice, Slack, and calls turned into programmable actions.",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "packages/integrations/*"],
  "scripts": {
    "test": "vitest run",
    "test:bun": "bun test apps/server/tests-bun packages/integrations/slack/tests-bun",
    "typecheck": "tsc --noEmit",
    "start": "bun run --cwd apps/desktop start",
    "server": "bun run apps/server/src/index.ts"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
